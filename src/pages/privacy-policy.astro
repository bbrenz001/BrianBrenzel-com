---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Privacy Policy · ${SITE_TITLE}`} description="Privacy Policy for brianbrenzel.com" />
	</head>
	<body>
		<Header />
		<main>
			<div class="page-header">
				<p class="page-label">// LEGAL</p>
				<h1>Privacy Policy</h1>
				<p class="page-meta">Last updated: November 2026</p>
			</div>

			<div class="prose">
				<h2>Overview</h2>
				<p>
					This Privacy Policy describes how Brian Brenzel ("I", "me", or "my") collects, uses,
					and handles information when you use this website (brianbrenzel.com) or contact me
					about my services.
				</p>

				<h2>Information I collect</h2>
				<p>When you fill out the contact form on this site, I collect:</p>
				<ul>
					<li>Your name</li>
					<li>Your email address</li>
					<li>Your phone number (if provided)</li>
					<li>The message you submit</li>
				</ul>
				<p>
					I do not use tracking pixels, third-party analytics platforms, or advertising cookies.
					Basic server logs may record your IP address and browser type as standard web infrastructure behavior.
				</p>

				<h2>How I use your information</h2>
				<p>I use contact form submissions solely to respond to your inquiry and communicate with you
				about potential or existing work. I do not send unsolicited marketing messages.</p>

				<h2>SMS and mobile communications</h2>
				<p>
					If you provide a mobile phone number and consent to receiving SMS communications,
					those messages will be used only to respond to your inquiry or provide updates
					about services you have requested.
				</p>
				<p>
					<strong>We will not share or sell your mobile information with third parties for
					promotional or marketing purposes.</strong> No mobile opt-in data or consent will be
					shared with any third party except as required to provide the communications service
					(e.g., the SMS carrier).
				</p>
				<p>Message and data rates may apply. You can opt out at any time by replying STOP.</p>

				<h2>Data sharing</h2>
				<p>
					I do not sell, rent, or share your personal information with third parties for their
					marketing purposes. I may share information with service providers who help me operate
					this website or deliver services (such as form processing tools), but only to the extent
					necessary to provide those services.
				</p>

				<h2>Data retention</h2>
				<p>
					I retain contact form submissions for as long as reasonably necessary to follow up on your
					inquiry or fulfill any service agreement. You can request deletion of your information
					by emailing <a href="mailto:brian@brianbrenzel.com">brian@brianbrenzel.com</a>.
				</p>

				<h2>Your rights</h2>
				<p>You have the right to request access to, correction of, or deletion of any personal
				information I hold about you. To make such a request, contact me at
				<a href="mailto:brian@brianbrenzel.com">brian@brianbrenzel.com</a>.</p>

				<h2>Changes to this policy</h2>
				<p>
					I may update this Privacy Policy from time to time. The date at the top of this page
					reflects when it was last revised.
				</p>

				<h2>Contact</h2>
				<p>
					Questions about this policy? Email me at
					<a href="mailto:brian@brianbrenzel.com">brian@brianbrenzel.com</a>.
				</p>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.page-header {
		margin-bottom: 3em;
	}

	.page-label {
		font-family: ui-monospace, 'Cascadia Code', 'Fira Mono', monospace;
		font-size: 0.78em;
		letter-spacing: 0.1em;
		color: var(--moss);
		margin: 0 0 0.75em 0;
	}

	.page-header h1 {
		font-size: 2.4em;
		margin: 0 0 0.3em 0;
	}

	.page-meta {
		font-size: 0.85em;
		color: var(--text-muted);
		margin: 0;
	}

	.prose {
		max-width: 680px;
	}

	.prose h2 {
		font-size: 1.1em;
		margin: 2em 0 0.5em 0;
		color: var(--text);
	}

	.prose p {
		font-size: 0.95em;
		color: var(--silver);
		line-height: 1.75;
		margin: 0 0 1em 0;
	}

	.prose ul {
		margin: 0 0 1em 0;
		padding-left: 1.5em;
	}

	.prose li {
		font-size: 0.95em;
		color: var(--silver);
		line-height: 1.7;
		margin-bottom: 0.25em;
	}

	.prose strong {
		color: var(--text);
	}

	.prose a {
		color: var(--moss);
	}
</style>
