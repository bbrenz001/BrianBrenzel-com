---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Page not found · ${SITE_TITLE}`} description="That page doesn't exist. Links to the blog, about, and contact pages instead." />
	</head>
	<body>
		<Header />
		<main>
			<div class="page-header">
				<p class="page-label">// 404</p>
				<h1>This page isn't here.</h1>
				<p class="page-desc">
					The link you followed points to something that doesn't exist, or
					used to and doesn't anymore. Try one of these instead.
				</p>
			</div>

			<div class="notfound-cta">
				<a href="/blog" class="btn btn-primary">Read the writing</a>
				<a href="/contact" class="btn btn-secondary">Get in touch</a>
				<a href="/" class="btn btn-secondary">Home</a>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.page-header {
		margin-bottom: 2.5em;
	}

	.page-label {
		font-family: ui-monospace, 'Cascadia Code', 'Fira Mono', monospace;
		font-size: 0.78em;
		letter-spacing: 0.1em;
		color: var(--turquoise);
		margin: 0 0 0.75em 0;
	}

	.page-header h1 {
		font-size: 2.4em;
		margin: 0 0 0.5em 0;
	}

	.page-desc {
		color: var(--silver);
		font-size: 0.95em;
		max-width: 520px;
		margin: 0;
		line-height: 1.75;
	}

	.notfound-cta {
		display: flex;
		gap: 1em;
		flex-wrap: wrap;
	}
</style>
