---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

// Replace with your actual n8n webhook URL
const N8N_WEBHOOK_URL = 'https://n8n.brianbrenzel.com/webhook/958ad9f7-2180-44c6-be76-34c80f5a8277';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Contact · ${SITE_TITLE}`} description="Get in touch about automation for your business." />
	</head>
	<body>
		<Header />
		<main>
			<div class="page-header">
				<p class="page-label">// CONTACT</p>
				<h1>Let's talk.</h1>
				<p class="page-desc">
					Tell me what you're doing manually. If it's repetitive, there's probably a way
					to automate it. I read every message myself and reply within 24 hours.
				</p>
			</div>

			<div class="contact-grid">
				<div class="contact-form-wrap">
					<form id="contact-form" class="contact-form" novalidate>
						<input type="hidden" name="bot-field" id="bot-field" />

						<div class="field-group">
							<label for="name">Name</label>
							<input type="text" id="name" name="name" placeholder="Your name" required autocomplete="name" />
						</div>

						<div class="field-group">
							<label for="email">Email</label>
							<input type="email" id="email" name="email" placeholder="your@email.com" required autocomplete="email" />
						</div>

						<div class="field-group">
							<label for="phone">Phone <span class="optional">(optional)</span></label>
							<input type="tel" id="phone" name="phone" placeholder="(555) 555-5555" autocomplete="tel" />
						</div>

						<div class="field-group">
							<label for="business">Business type <span class="optional">(optional)</span></label>
							<input type="text" id="business" name="business" placeholder="e.g. Med spa, salon, clinic" />
						</div>

						<div class="field-group">
							<label for="message">What are you doing manually that you wish was automated?</label>
							<textarea id="message" name="message" rows="5" placeholder="Describe the process. Even rough is fine." required></textarea>
						</div>

						<div class="form-footer">
							<button type="submit" class="btn btn-primary" id="submit-btn">
								<span id="btn-text">Send it</span>
								<span id="btn-loading" style="display:none;">Sending...</span>
							</button>
						</div>
					</form>

					<div id="form-success" class="form-success" style="display:none;">
						<p class="success-icon">✓</p>
						<h3>Got it.</h3>
						<p>I'll be in touch within 24 hours.</p>
					</div>

					<div id="form-error" class="form-error" style="display:none;">
						<p>Something went wrong. Email me directly at <a href="mailto:brian@brianbrenzel.com">brian@brianbrenzel.com</a>.</p>
					</div>
				</div>

				<div class="contact-aside">
					<div class="aside-block">
						<p class="aside-label">// RESPONSE TIME</p>
						<p>I check messages daily. You'll hear back within 24 hours, usually faster.</p>
					</div>
					<div class="aside-block">
						<p class="aside-label">// WHAT HAPPENS NEXT</p>
						<p>I'll reply, ask a few questions, and we'll schedule a free scoping call if it makes sense to move forward.</p>
					</div>
					<div class="aside-block">
						<p class="aside-label">// EMAIL</p>
						<a href="mailto:brian@brianbrenzel.com">brian@brianbrenzel.com</a>
					</div>
					<div class="aside-block">
						<p class="aside-label">// LOCATION</p>
						<p>California</p>
					</div>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>

<script define:vars={{ N8N_WEBHOOK_URL }}>
	const form = document.getElementById('contact-form');
	const submitBtn = document.getElementById('submit-btn');
	const btnText = document.getElementById('btn-text');
	const btnLoading = document.getElementById('btn-loading');
	const successEl = document.getElementById('form-success');
	const errorEl = document.getElementById('form-error');

	form.addEventListener('submit', async (e) => {
		e.preventDefault();

		// Honeypot check
		if (document.getElementById('bot-field').value) return;

		// Basic validation
		const name = form.querySelector('#name').value.trim();
		const email = form.querySelector('#email').value.trim();
		const message = form.querySelector('#message').value.trim();
		if (!name || !email || !message) return;

		// Loading state
		submitBtn.disabled = true;
		btnText.style.display = 'none';
		btnLoading.style.display = 'inline';

		const payload = {
			name,
			email,
			phone: form.querySelector('#phone').value.trim(),
			business: form.querySelector('#business').value.trim(),
			message,
			source: 'brianbrenzel.com/contact',
			submitted_at: new Date().toISOString(),
		};

		try {
			const res = await fetch(N8N_WEBHOOK_URL, {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify(payload),
			});

			if (res.ok) {
				form.style.display = 'none';
				successEl.style.display = 'block';
			} else {
				throw new Error('Non-OK response');
			}
		} catch {
			form.style.display = 'none';
			errorEl.style.display = 'block';
		}
	});
</script>

<style>
	.page-header {
		margin-bottom: 3em;
	}

	.page-label {
		font-family: ui-monospace, 'Cascadia Code', 'Fira Mono', monospace;
		font-size: 0.78em;
		letter-spacing: 0.1em;
		color: var(--moss);
		margin: 0 0 0.75em 0;
	}

	.page-header h1 {
		font-size: 2.4em;
		margin: 0 0 0.5em 0;
	}

	.page-desc {
		color: var(--silver);
		font-size: 0.95em;
		max-width: 520px;
		margin: 0;
		line-height: 1.75;
	}

	.contact-grid {
		display: grid;
		grid-template-columns: 1fr 320px;
		gap: 4em;
		align-items: start;
	}

	/* ── Form ──────────────────────────────────── */
	.contact-form {
		display: flex;
		flex-direction: column;
		gap: 1.25em;
	}

	.field-group {
		display: flex;
		flex-direction: column;
		gap: 0.4em;
	}

	.field-group label {
		font-size: 0.85em;
		font-weight: 600;
		color: var(--text-muted);
	}

	.optional {
		font-weight: 400;
		color: var(--text-muted);
		opacity: 0.7;
	}

	.field-group input,
	.field-group textarea {
		background-color: #FFFFFF;
		border: 1px solid var(--bg-border);
		color: var(--text);
		border-radius: 4px;
		padding: 0.65em 0.9em;
		font-size: 1em;
		font-family: inherit;
		width: 100%;
		box-sizing: border-box;
		transition: border-color 0.15s ease;
	}

	.field-group input:focus,
	.field-group textarea:focus {
		outline: none;
		border-color: var(--moss);
		box-shadow: 0 0 0 3px var(--moss-glow);
	}

	.field-group textarea {
		resize: vertical;
		line-height: 1.6;
	}

	.form-footer {
		padding-top: 0.25em;
	}

	.btn {
		display: inline-block;
		padding: 0.7em 1.8em;
		border-radius: 4px;
		font-size: 0.95em;
		font-weight: 600;
		border: none;
		cursor: pointer;
		text-decoration: none;
		transition: all 0.15s ease;
	}

	.btn-primary {
		background-color: var(--red);
		color: #FFFFFF;
	}
	.btn-primary:hover:not(:disabled) { background-color: var(--red-dark); }
	.btn-primary:disabled { opacity: 0.6; cursor: not-allowed; }

	/* ── Success / error states ────────────────── */
	.form-success {
		padding: 2em 0;
		text-align: left;
	}

	.success-icon {
		font-size: 1.5em;
		color: var(--moss);
		margin: 0 0 0.5em 0;
	}

	.form-success h3 {
		font-size: 1.3em;
		margin: 0 0 0.4em 0;
		color: var(--text);
	}

	.form-success p {
		font-size: 0.95em;
		color: var(--silver);
		margin: 0;
	}

	.form-error {
		padding: 1.5em;
		background-color: var(--bg-surface);
		border: 1px solid var(--bg-border);
		border-radius: 4px;
	}

	.form-error p {
		font-size: 0.95em;
		color: var(--silver);
		margin: 0;
	}

	.form-error a {
		color: var(--moss);
	}

	/* ── Aside ─────────────────────────────────── */
	.contact-aside {
		display: flex;
		flex-direction: column;
		gap: 2em;
		padding-top: 0.25em;
	}

	.aside-block {
		border-left: 2px solid var(--bg-border);
		padding-left: 1.25em;
	}

	.aside-label {
		font-family: ui-monospace, 'Cascadia Code', 'Fira Mono', monospace;
		font-size: 0.75em;
		letter-spacing: 0.1em;
		color: var(--moss);
		margin: 0 0 0.5em 0;
	}

	.aside-block p {
		font-size: 0.9em;
		color: var(--silver-light);
		margin: 0;
		line-height: 1.65;
	}

	.aside-block a {
		font-size: 0.9em;
		color: var(--moss);
	}

	@media (max-width: 720px) {
		.contact-grid {
			grid-template-columns: 1fr;
			gap: 2.5em;
		}
	}
</style>
