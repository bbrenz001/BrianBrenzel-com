---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Terms of Service · ${SITE_TITLE}`} description="Terms of Service for brianbrenzel.com" />
	</head>
	<body>
		<Header />
		<main>
			<div class="page-header">
				<p class="page-label">// LEGAL</p>
				<h1>Terms of Service</h1>
				<p class="page-meta">Last updated: November 2026</p>
			</div>

			<div class="prose">
				<h2>Agreement</h2>
				<p>
					By accessing this website (brianbrenzel.com) or using any services provided by
					Brian Brenzel, you agree to these Terms of Service. If you do not agree, please
					do not use this site.
				</p>

				<h2>Services</h2>
				<p>
					Brian Brenzel provides workflow automation consulting and development services for
					small businesses. The specific scope, deliverables, timeline, and payment terms
					for any engagement are defined in a separate written agreement between the client
					and Brian Brenzel.
				</p>

				<h2>Website use</h2>
				<p>
					This website is provided for informational purposes. You may use it to learn about
					my services and to contact me. You agree not to use this site for any unlawful
					purpose or in any way that could damage, disable, or impair the site.
				</p>

				<h2>Intellectual property</h2>
				<p>
					The content on this site (text, design, and code) is owned by Brian Brenzel
					unless otherwise noted. You may not reproduce or redistribute it without permission.
					Work product delivered to clients under a service agreement is governed by the terms
					of that agreement.
				</p>

				<h2>Disclaimer of warranties</h2>
				<p>
					This website is provided "as is" without warranty of any kind. I make no guarantees
					about the accuracy, completeness, or availability of the content on this site.
				</p>

				<h2>Limitation of liability</h2>
				<p>
					To the maximum extent permitted by applicable law, Brian Brenzel shall not be liable
					for any indirect, incidental, or consequential damages arising from your use of this
					website or any services described herein, beyond what is covered in a signed service
					agreement.
				</p>

				<h2>Changes</h2>
				<p>
					I may update these Terms at any time. The date at the top of this page reflects
					when they were last revised. Continued use of the site after changes constitutes
					acceptance of the updated Terms.
				</p>

				<h2>Contact</h2>
				<p>
					Questions? Email <a href="mailto:brian@brianbrenzel.com">brian@brianbrenzel.com</a>.
				</p>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.page-header {
		margin-bottom: 3em;
	}

	.page-label {
		font-family: ui-monospace, 'Cascadia Code', 'Fira Mono', monospace;
		font-size: 0.78em;
		letter-spacing: 0.1em;
		color: var(--moss);
		margin: 0 0 0.75em 0;
	}

	.page-header h1 {
		font-size: 2.4em;
		margin: 0 0 0.3em 0;
	}

	.page-meta {
		font-size: 0.85em;
		color: var(--text-muted);
		margin: 0;
	}

	.prose {
		max-width: 680px;
	}

	.prose h2 {
		font-size: 1.1em;
		margin: 2em 0 0.5em 0;
		color: var(--text);
	}

	.prose p {
		font-size: 0.95em;
		color: var(--silver);
		line-height: 1.75;
		margin: 0 0 1em 0;
	}

	.prose a {
		color: var(--moss);
	}
</style>
