---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />

		<section class="hero">
			<div class="hero-inner">
				<p class="hero-label">// AUTOMATION FOR SMALL BUSINESSES</p>
				<h1 class="hero-headline">
					Stop doing by hand what a system can do for you.
				</h1>
				<p class="hero-body">
					I build automations that follow up with leads, log activity to your CRM, and send
					the right message at the right time. You close more business. You stop falling through cracks.
				</p>
				<div class="hero-ctas">
					<a href="/contact" class="btn btn-primary">Get in touch</a>
					<a href="/services" class="btn btn-secondary">What I build</a>
				</div>
			</div>
			<div class="hero-horizon"></div>
		</section>

		<main>

			<section class="how-it-works">
				<p class="section-label">// HOW IT WORKS</p>
				<div class="steps">
					<div class="step">
						<span class="step-num">01</span>
						<h3>Tell me what's slipping</h3>
						<p>Leads not followed up. No-shows not rescheduled. Bookings not logged. Pick the problem that costs you the most.</p>
					</div>
					<div class="step">
						<span class="step-num">02</span>
						<h3>I build the workflow</h3>
						<p>I connect your existing tools and build the automation. Most builds take a week or less.</p>
					</div>
					<div class="step">
						<span class="step-num">03</span>
						<h3>It runs without you</h3>
						<p>You get a walkthrough, a loom, and a system that works while you're with clients.</p>
					</div>
				</div>
			</section>

			<section class="services-preview">
				<p class="section-label">// WHAT I BUILD</p>
				<ul class="service-list">
					<li class="service-item">
						<h3>Lead follow-up</h3>
						<p>New inquiry comes in, automated message goes out within minutes. No leads sit cold.</p>
					</li>
					<li class="service-item">
						<h3>CRM logging</h3>
						<p>Bookings, cancellations, and notes flow into your CRM automatically. No manual data entry.</p>
					</li>
					<li class="service-item">
						<h3>Appointment workflows</h3>
						<p>Reminders, confirmations, and no-show follow-ups go out automatically. You don't touch it.</p>
					</li>
				</ul>
				<a href="/services" class="all-link">See all services →</a>
			</section>

			<section class="cta-block">
				<div class="cta-inner">
					<p class="section-label">// LET'S TALK</p>
					<h2>Tell me what you're doing by hand.</h2>
					<p>If it's repetitive and rule-based, there's probably a way to automate it. No commitment to reach out.</p>
					<a href="/contact" class="btn btn-primary">Get in touch</a>
				</div>
			</section>

		</main>

		<Footer />
	</body>
</html>

<style>
	/* ── Hero ──────────────────────────────────── */
	.hero {
		background-color: var(--bg);
		background-image: radial-gradient(ellipse 80% 50% at 20% 100%, rgba(65, 64, 60, 0.04) 0%, transparent 60%),
		                  radial-gradient(ellipse 60% 40% at 80% 100%, rgba(110, 106, 79, 0.06) 0%, transparent 60%);
		padding: 5em 1.5em 0;
	}

	.hero-inner {
		max-width: 760px;
		margin: 0 auto;
		padding-bottom: 4em;
	}

	.hero-label {
		font-family: ui-monospace, 'Cascadia Code', 'Fira Mono', monospace;
		font-size: 0.78em;
		letter-spacing: 0.1em;
		color: var(--moss);
		margin: 0 0 1.25em 0;
	}

	.hero-headline {
		font-size: 2.8em;
		line-height: 1.15;
		margin: 0 0 0.75em 0;
		color: var(--text);
	}

	.hero-body {
		font-size: 1.05em;
		color: var(--silver-light);
		max-width: 580px;
		margin: 0 0 2em 0;
		line-height: 1.75;
	}

	.hero-ctas {
		display: flex;
		gap: 1em;
		flex-wrap: wrap;
	}

	.hero-horizon {
		height: 2px;
		background: var(--horizon);
		max-width: 760px;
		margin: 0 auto;
		opacity: 0.9;
	}

	/* ── Buttons ───────────────────────────────── */
	.btn {
		display: inline-block;
		padding: 0.65em 1.4em;
		border-radius: 4px;
		font-size: 0.95em;
		font-weight: 600;
		cursor: pointer;
		text-decoration: none;
		transition: all 0.15s ease;
	}
	.btn:hover { text-decoration: none; }

	.btn-primary {
		background-color: var(--red);
		color: #FFFFFF;
	}
	.btn-primary:hover { background-color: var(--red-dark); }

	.btn-secondary {
		background-color: transparent;
		color: var(--moss);
		border: 1px solid var(--moss);
	}
	.btn-secondary:hover { background-color: var(--moss-glow); }

	/* ── Shared ────────────────────────────────── */
	.section-label {
		font-family: ui-monospace, 'Cascadia Code', 'Fira Mono', monospace;
		font-size: 0.78em;
		letter-spacing: 0.1em;
		color: var(--moss);
		margin: 0 0 1.5em 0;
	}

	.all-link {
		display: inline-block;
		margin-top: 1.5em;
		font-size: 0.9em;
		color: var(--moss);
		text-decoration: none;
		font-weight: 600;
	}
	.all-link:hover { text-decoration: underline; }

	/* ── How it works ──────────────────────────── */
	.how-it-works {
		margin-bottom: 4em;
	}

	.steps {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 2em;
	}

	.step {
		border-left: 2px solid var(--bg-border);
		padding-left: 1.25em;
	}

	.step-num {
		font-family: ui-monospace, 'Cascadia Code', 'Fira Mono', monospace;
		font-size: 0.75em;
		color: var(--moss);
		letter-spacing: 0.1em;
		display: block;
		margin-bottom: 0.6em;
	}

	.step h3 {
		font-size: 1em;
		margin: 0 0 0.5em 0;
		color: var(--text);
	}

	.step p {
		font-size: 0.9em;
		color: var(--silver);
		margin: 0;
		line-height: 1.65;
	}

	/* ── Services preview ──────────────────────── */
	.services-preview {
		margin-bottom: 4em;
	}

	.service-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.service-item {
		border-top: 1px solid var(--bg-border);
		padding: 1.4em 0;
	}
	.service-item:last-child {
		border-bottom: 1px solid var(--bg-border);
	}

	.service-item h3 {
		font-size: 1.05em;
		margin: 0 0 0.35em 0;
		color: var(--text);
	}

	.service-item p {
		font-size: 0.92em;
		color: var(--silver);
		margin: 0;
		line-height: 1.6;
	}

	/* ── CTA block ─────────────────────────────── */
	.cta-block {
		margin-bottom: 2em;
	}

	.cta-inner {
		background-color: var(--bg-surface);
		border: 1px solid var(--bg-border);
		border-radius: 8px;
		padding: 2.5em;
	}

	.cta-inner h2 {
		font-size: 1.6em;
		margin: 0 0 0.6em 0;
		color: var(--text);
	}

	.cta-inner p {
		font-size: 0.95em;
		color: var(--silver);
		max-width: 480px;
		margin: 0 0 1.5em 0;
		line-height: 1.7;
	}

	/* ── Responsive ────────────────────────────── */
	@media (max-width: 720px) {
		.hero { padding: 3em 1em 0; }
		.hero-headline { font-size: 2em; }
		.steps { grid-template-columns: 1fr; }
		.cta-inner { padding: 1.5em; }
	}
</style>
